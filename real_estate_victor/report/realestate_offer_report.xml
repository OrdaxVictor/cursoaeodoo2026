<?xml version="1.0" encoding="UTF-8"?>

<odoo>

<record id="paperformat_realestate_offer" model="report.paperformat">
    <field name="name">Offer Paperformat</field>
    <field name="format">A4</field>
    <field name="orientation">Portrait</field>
    <field name="margin_top">15</field>
    <field name="margin_bottom">15</field>
    <field name="margin_left">15</field>
    <field name="margin_right">15</field>
    <field name="dpi">90</field>
</record>

<record id="action_report_realestate_offer" model="ir.actions.report">
    <field name="name">Offer</field>
    <field name="model">realestate.offer</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">real_estate_victor.realestate_offer_report</field>
    <field name="report_file">real_estate_victor.realestate_offer_report</field>
    <field name="print_report_name">'Offer - %s' % (object.property_id.display_name or '')</field>
    <field name="paperformat_id" ref="paperformat_realestate_offer"/>
    <field name="binding_model_id" ref="model_realestate_offer"/>
    <field name="binding_type">report</field>
    <field name="binding_view_types">list,form</field>
</record>


<template id="realestate_offer_report">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="o">
        <t t-call="web.external_layout">
            <div class="page">
                <h2>Offer</h2>
                <div class="row mt-3 mb-3">
                    <div class="col-6">
                        <strong>Property:</strong> <span t-field="o.property_id"/>
                    </div>
                    <div class="col-6">
                        <strong>Buyer:</strong> <span t-field="o.partner_id"/>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-4">
                        <strong>Offer:</strong> <span t-field="o.offer"/>
                    </div>
                    <div class="col-4">
                        <strong>Offer date:</strong> <span t-field="o.date"/>
                    </div>
                    <div class="col-4">
                        <strong>Status:</strong> <span t-field="o.status"/>
                    </div>
                </div>
            </div>
        </t>
        </t>
    </t>
</template>

</odoo>
